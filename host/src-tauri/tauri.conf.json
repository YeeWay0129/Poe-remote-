{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "遠端 POE Host",
  "version": "0.1.0",
  "identifier": "local.remote-poe.host",
  "build": {
    "beforeDevCommand": "npm run dev:web",
    "beforeBuildCommand": "npm run build:web",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "遠端 POE Host",
        "width": 900,
        "height": 680
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
